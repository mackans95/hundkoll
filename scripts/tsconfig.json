{
	// scripts/ run directly under Node 24's type stripping, outside the app's
	// bundler project — their own nodenext project, type-checked by npm run
	// check. erasableSyntaxOnly guards the stripping: no enums, no namespaces.
	"compilerOptions": {
		"lib": ["esnext"],
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts"]
}

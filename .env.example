# Supabase project URL — the bare https://<ref>.supabase.co host, with NO
# path suffix. Do not paste the Data API URL (…/rest/v1): supabase-js appends
# service paths itself, and a suffixed base breaks auth with a 404
# "Invalid path specified in request URL".
PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe to expose in the browser
# because RLS is enforced — it identifies the app, not the user.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

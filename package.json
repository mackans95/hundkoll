{
	"name": "hundkoll",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "git config core.hooksPath .githooks; svelte-kit sync || echo ''",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && tsc -p scripts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"autofix": "npx @sveltejs/mcp svelte-autofixer",
		"test": "vitest run",
		"db-local": "node scripts/db-local.ts",
		"db-local:reset": "supabase db reset",
		"db-local:stop": "supabase stop",
		"db-pull": "node scripts/db-pull.ts",
		"dev:local": "vite dev --mode localdb",
		"db-push": "supabase db push",
		"functions-deploy": "supabase functions deploy remind",
		"gen-types": "supabase gen types typescript --linked > src/lib/types/database.ts",
		"new-event": "node scripts/new-event.ts",
		"android:build": "cap sync android && cd android && ./gradlew assembleRelease",
		"android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.2",
		"@capacitor/cli": "^8.5.2",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"supabase": "^2.113.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/core": "^8.5.2",
		"@capacitor/push-notifications": "^8.1.2",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3"
	}
}
